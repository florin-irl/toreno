<Window x:Class="Toreno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Toreno"
        mc:Ignorable="d"
        Title="Toreno" Height="640" Width="900"
        Icon="pack://application:,,,/Resources/tray.ico"
        Background="{StaticResource BackgroundBrush}"
        Closing="MainWindow_OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="TORENO" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="Bold" />
                <TextBlock Text="BY FLORIN-IRL" Style="{StaticResource CaptionStyle}"
                           Margin="14,0,0,7" VerticalAlignment="Bottom" />
            </StackPanel>
            <Border Height="3" Background="{StaticResource AccentBrush}" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Add server toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SERVER ADDRESS" Style="{StaticResource CaptionStyle}" Margin="2,0,0,4" />
                <TextBox x:Name="AddressTextBox" Text="127.0.0.1:7777" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="DISPLAY NAME (OPTIONAL)" Style="{StaticResource CaptionStyle}" Margin="2,0,0,4" />
                <TextBox x:Name="NameTextBox" />
            </StackPanel>

            <Button Grid.Column="4" Content="ADD SERVER" Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Bottom" Click="AddServerButton_OnClick" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Servers panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="SERVERS" Style="{StaticResource SectionHeaderStyle}" />
                    <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentBrush}"
                            Opacity="0.6" Margin="0,8,0,12" />

                    <Grid>
                        <ListBox x:Name="ServersListBox" SelectionChanged="ServersListBox_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="&#x21BB;" FontSize="14"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Recheck status" VerticalAlignment="Top"
                                                Click="ItemRecheckButton_OnClick" />

                                        <Button Grid.Column="2" Content="&#x2715;" FontSize="12"
                                                Style="{StaticResource DangerIconButtonStyle}"
                                                ToolTip="Remove server" VerticalAlignment="Top" Margin="4,0,0,0"
                                                Click="ItemRemoveButton_OnClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No servers yet.&#x0a;Add one above to start watching.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ServersListBox, Path=HasItems}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Watched usernames panel -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="WATCHED USERNAMES"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentBrush}"
                            Opacity="0.6" Margin="0,8,0,12" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameTextBox" Grid.Column="0" IsEnabled="False" />
                        <Button x:Name="AddUsernameButton" Grid.Column="1" Content="ADD" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddUsernameButton_OnClick" IsEnabled="False" />
                        <Button x:Name="RemoveUsernameButton" Grid.Column="2" Content="REMOVE" Margin="8,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveUsernameButton_OnClick" IsEnabled="False" />
                    </Grid>

                    <Grid>
                        <ListBox x:Name="UsernamesListBox" />
                        <TextBlock Text="No usernames watched yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=UsernamesListBox, Path=HasItems}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
