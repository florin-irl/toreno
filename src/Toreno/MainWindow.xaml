<Window x:Class="Toreno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Toreno"
        mc:Ignorable="d"
        Title="Toreno" Height="640" Width="1040"
        Icon="pack://application:,,,/Resources/tray.ico"
        Background="{StaticResource BackgroundBrush}"
        Closing="MainWindow_OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="TORENO" FontFamily="Bahnschrift SemiBold" FontSize="34" FontWeight="Bold" />
                <TextBlock Text="BY FLORIN-IRL" Style="{StaticResource CaptionStyle}"
                           Margin="14,0,0,7" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="&#x2139;" FontSize="18" Style="{StaticResource IconButtonStyle}"
                        ToolTip="About" Width="32" Height="32" Margin="0,0,0,2"
                        Click="AboutButton_OnClick" />
                <Button Content="&#x2699;" FontSize="18" Style="{StaticResource IconButtonStyle}"
                        ToolTip="Settings" Width="32" Height="32" Margin="8,0,0,2"
                        Click="SettingsButton_OnClick" />
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="3"
                    Background="{StaticResource AccentBrush}" Margin="0,10,0,0" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Servers panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel Margin="16">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SERVERS" Style="{StaticResource SectionHeaderStyle}" />
                        <Button Grid.Column="1" Content="+" FontSize="16" FontWeight="Bold"
                                Style="{StaticResource IconButtonStyle}" ToolTip="Add server"
                                Width="22" Height="22" Click="AddServerIconButton_OnClick" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentBrush}"
                            Opacity="0.6" Margin="0,8,0,12" />

                    <Grid>
                        <ListBox x:Name="ServersListBox" SelectionChanged="ServersListBox_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="&#x21BB;" FontSize="14"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Recheck status" VerticalAlignment="Top"
                                                Click="ItemRecheckButton_OnClick" />

                                        <Button Grid.Column="2" Content="&#x2715;" FontSize="12"
                                                Style="{StaticResource DangerIconButtonStyle}"
                                                ToolTip="Remove server" VerticalAlignment="Top" Margin="4,0,0,0"
                                                Click="ItemRemoveButton_OnClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No servers yet.&#x0a;Press + above to add one.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ServersListBox, Path=HasItems}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Watched usernames panel -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Server players (left) -->
                    <DockPanel Grid.Column="0">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SERVER PLAYERS" Style="{StaticResource SectionHeaderStyle}" />
                            <Button Grid.Column="1" Content="&#x21BB;" FontSize="14"
                                    Style="{StaticResource IconButtonStyle}" ToolTip="Refresh player list"
                                    Width="22" Height="22" Click="RefreshServerPlayersButton_OnClick" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentBrush}"
                                Opacity="0.6" Margin="0,8,0,12" />

                        <Grid>
                            <ListBox x:Name="ServerPlayersListBox"
                                     SelectionChanged="ServerPlayersListBox_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NameText" Grid.Column="0" Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="CheckText" Grid.Column="1" Text="&#x2713;"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                                       Visibility="Collapsed" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                <Setter TargetName="CheckText" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="NameText" Property="Foreground"
                                                        Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Select a server to see who's online.&#x0a;Click a name to watch/unwatch it.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ServerPlayersListBox, Path=HasItems}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Grid.Column="2" Background="{StaticResource BorderBrush}" />

                    <!-- Monitored (right) -->
                    <DockPanel Grid.Column="4">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MONITORED" Style="{StaticResource SectionHeaderStyle}" />
                            <Button x:Name="AddUsernameIconButton" Grid.Column="1" Content="+" FontSize="16"
                                    FontWeight="Bold" Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Add username" Width="22" Height="22" IsEnabled="False"
                                    Click="AddUsernameIconButton_OnClick" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentBrush}"
                                Opacity="0.6" Margin="0,8,0,12" />

                        <Grid>
                            <ListBox x:Name="UsernamesListBox">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28" Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="&#x2715;" FontSize="11"
                                                    Style="{StaticResource DangerIconButtonStyle}"
                                                    ToolTip="Remove" Width="22" Height="22"
                                                    HorizontalAlignment="Center"
                                                    Click="RemoveUsernameIconButton_OnClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No usernames watched yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=UsernamesListBox, Path=HasItems}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
